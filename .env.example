# Server Port (Render sets this automatically)
PORT=5000

# Security & Authentication Secrets (Required in production)
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# Storage Configuration
UPLOAD_DIR=uploads

# Allowed Frontend Origins (Optional - comma-separated list of URLs)
# E.g. https://your-frontend.vercel.app,http://localhost:5173
# Leave empty to allow all origins
CORS_ORIGIN=
